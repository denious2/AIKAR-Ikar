{
  "_README": "Режиссерский конфиг. Управляет структурой песни, правилами секций, пулами ассетов и стилями.",
  "layers": {
    "0_audio": "Аудио трек (Скрытый слой)",
    "1_paper": "Базовый фон (.layer-bg)",
    "2_main": "Основные сцены (.layer-hero: центр, #host-images)",
    "4_fly": "Ассеты полета (.layer-fg)",
    "6_text": "Субтитры (#host-subs)",
    "7_top": "Пыль, глитчи и транзишены (.texture-wrapper, #host-accents, #shadow-crush-overlay, #screen-flash-overlay)",
    "8_logo": "Логотип (#host-logo)"
  },
  "songStructure": [
    { "time": 0.0, "name": "Intro (Пробуждение)", "type": "intro" },
    { "time": 9.53, "name": "Verse (Починка крыльев)", "type": "verse" },
    { "time": 39.0, "name": "Hook (В небе)", "type": "hook" },    
    { "time": 44.00, "name": "Chorus (Полет)", "type": "chorus" },
    { "time": 60.00, "name": "Outro (Падение)", "type": "outro" },
    { "time": 74.00, "name": "Лого (Копирайты)", "type": "copyright" }    
  ],
  "sectionTypeRules": {
    "intro":     { "allowedLayers": [1, 2, 3, 6], "blackout": false, "globalFilter": "color_burn_middle"},
    "verse":     { "allowedLayers": [1, 2, 3, 6, 7], "blackout": false, "textStyle": "lighting_box" },
    "hook":      { "allowedLayers": [4], "blackout": false, "globalFilter": "color_burn_low" },
    "chorus":    { "allowedLayers": [1, 2, 3, 6, 7], "blackout": false, "textStyle": "lighting_box" },
    "outro":     { "allowedLayers": [2, 6, 7], "blackout": false, "globalFilter": "color_burn_middle" },
    "copyright": { "allowedLayers": [5], "blackout": false }    
  },
  "behaviorClasses": {
    "narrative": { "strategy": "sequence", "maxDuration": null },
    "atmosphere": { "strategy": "dynamic_slots", "maxDuration": 6.0 },
    "flash": { "strategy": "random_flash", "duration": 0.4 }
  },
  "overlays": {
    "shadowCrush": "shadow_crush_default",
    "screenFlash": "screen_flash_white"
  },
  "subtitlesConfig": {
    "enabled": true,
    "defaultStyle": "base_box",
    "overrideBySectionType": {
      "chorus": {
        "style": "chorus_impact",
        "animation": {
          "entrance": "glitch_snap",
          "durationIn": 0.15,
          "exit": "soft_fade",
          "durationOut": 0.2,
          "motion": "rapid_pulse"
        }
      },
      "hook": {
        "style": "hook_glitch",
        "animation": {
          "entrance": "hard_cut",
          "durationIn": 0.05,
          "exit": "hard_cut",
          "durationOut": 0.05,
          "motion": "aggressive_shake"
        }
      }
    }
  },
  "beatsConfig": {
    "enabled": true,
    "sourceFile": "beats.json",
    "decay": 0.15,
    "multiplier": 1,
    "type": "solid",
    "dynamics": "sharp",
    "color": "#ffffff",
    "intensity": 0.4
  },
  "bass": {
    "enabled": true,
    "sourceFile": "bass.json",
    "decay": 0.3
  },
  "melody": {
    "enabled": true,
    "sourceFile": "melody.json",
    "decay": 0.2
  },
  "vocal": {
    "enabled": true,
    "sourceFile": "vocal.json",
    "decay": 0.2
  },
  "accents": {
    "enabled": true,
    "sourceFile": "accents.json",
    "shakes": {
      "enabled": true,
      "duration": 0.25,
      "pool": ["capcut_shake_v1", "none", "impact_zoom", "none", "micro_seismic", "none"]
    },
    "videoGlitches": {
      "enabled": true,
      "duration": 0.6,
      "file": "media/sfx/accents/glitch-vert-12.mp4",
      "blendMode": "screen",
      "slices": 8,
      "sequence": [2, 3, "none", "none", 5, 8, "none", 6, 12, "none", 3],
      "style": "purple_neon"
    }
  },
  "audioReactors": {
    "enabled": true,
    "nodes": [
      {
        "name": "Пульсация пыли (Атмосфера)",
        "description": "Слегка увеличивает масштаб слоя шумов/текстур.",
        "target": "#host-dust",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "scale(calc(1 + var(--beat) * 0.05))" }
        ],
        "transition": "transform 0.05s ease-out"
      },
      {
        "name": "Светлое мерцание (Вспышка)",
        "description": "Мягкая белая вспышка виньетки.",
        "target": "#screen-flash-overlay",
        "cssProperty": "opacity",
        "formulaParts": [
          { "code": "calc(var(--beat) * 0.15)" }
        ],
        "transition": "opacity 0.05s ease-out"
      },
      {
        "name": "Плотное затемнение теней",
        "description": "Базовое затемнение, которое уплотняется при ударе баса.",
        "target": "#shadow-crush-overlay",
        "cssProperty": "opacity",
        "formulaParts": [
          { "code": "calc(0.3 + var(--bass) * 0.6)" }
        ],
        "transition": "opacity 0.05s ease-out"
      },
      {
        "name": "Раздвижение букв в титрах",
        "description": "Растягивает трекинг и растаскивает символы титров по удару барабана.",
        "target": "#host-subs *",
        "cssProperty": "letter-spacing",
        "formulaParts": [
          { "code": "calc(var(--beat) * 8px)", "note": "Реальное увеличение расстояния между символами" }
        ],
        "transition": "letter-spacing 0.03s ease-out"
      },
      {
        "name": "Цветовой CSS-Глитч",
        "description": "Жестко сдвигает цвета на 180 градусов, пробивая глобальный фильтр.",
        "target": "#host-images",
        "cssProperty": "filter",
        "formulaParts": [
          { "code": "hue-rotate(calc(var(--beat) * 180deg))" },
          { "code": "saturate(calc(1 + var(--beat) * 5))" }
        ],
        "transition": "filter 0.03s steps(2)"
      },
      {
        "name": "Кинетический сдвиг (Геометрия)",
        "description": "Наклоняет и смещает картинку в момент удара.",
        "target": "#host-images",
        "cssProperty": "transform",
        "formulaParts": [
          { "code": "skewX(calc(var(--beat) * -5deg))" },
          { "code": "translate(calc(var(--beat) * 8px), calc(var(--beat) * -5px))" },
          { "code": "scale(calc(1 + var(--beat) * 0.05))" }
        ],
        "transition": "transform 0.03s steps(2)"
      },
      {
        "name": "Игра контраста и света на Герое (Огибающая)",
        "description": "Заменяет скучный задник: контраст и яркость главного героя нарастают к центру трека по огибающей.",
        "target": "#host-images",
        "cssProperty": "filter",
        "formulaParts": [
          { "code": "contrast(calc(1 + var(--env) * 0.4))", "note": "Рост контраста по огибающей" },
          { "code": "brightness(calc(1 + var(--env) * 0.2))", "note": "Просветление поверхностей" }
        ],
        "envelope": {
          "mode": "curve",
          "points": [
            { "x": 0.0, "y": 0.0 },
            { "x": 0.5, "y": 1.0 },
            { "x": 1.0, "y": 0.0 }
          ]
        },
        "transition": "filter 0.1s ease-out"
      }
    ]
  },
  "directorOverrides": {
    "_hint": "Здесь можно жестко привязать директивы к конкретным файлам",
    "files": {
      "i-0015.mp4": { "movement": "cinematic_zoom_in_shake", "appearance": "soft_fade" },
      "i-05.png": { "movement": "micro_jitter", "appearance": "hard_cut" },
      "i-0013.mp4": { "movement": "cinematic_zoom_in_shake", "appearance": "hard_cut" },
      "i-08.mp4": { "entrance": "hard_cut", "exit": "burn_out" },      
      "i-12.png": { "movement": "cinematic_zoom_in_shake" },
      "i-12-prlx-b1.png": { "movement": "slide_run_right_heavy" },      
      "i-13.mp4": { "appearance": "soft_fade" },
      "i-13_2.png": { "movement": "cinematic_zoom_in_shake" },
      "i-13_2-prlx-b-1.png": { "movement": "downfall_with_spin" },      
      "i-15.png": { "movement": "slash_anime_flyby" },      
      "i-15-prlx-b-1.png": { "movement": "rise_jitter_up" },      
      "i-15-prlx-b1.png": { "movement": "downfall" },
      "i-16.png": { "movement": "downfall_with_spin" },    
      "i-16-prlx-b-1.png": { "movement": "rise_jitter_up" },
      "i-16-prlx-b1.png": { "movement": "cinematic_zoom_in_shake" },
      "pl12.mp4": { "appearance": "soft_fade" } 
    }
  },
  "assetPools": {
    "sketches": {
      "enabled": true,
      "class": "narrative",
      "layerIndex": 2,
      "path": "media/Scenes",
      "blendMode": "multiply",
      "baseOpacity": 1.0,
      "allowedMovements": ["fast_dolly_in", "aggressive_shake", "glitch_pan_left", "glitch_pan_right", "rapid_pulse", "cinematic_zoom_in_shake"],
      "allowedMovements_b-1": ["slow_pan_left", "slow_pan_right", "micro_jitter"],
      "allowedMovements_b1": ["slow_pan_left", "slow_pan_right", "micro_jitter"],
      "allowedMovements_b2": ["rapid_pulse", "subtle_zoom"],
      "defaultAppearance": "glitch_snap"
    },
    "fly": {
      "enabled": true,
      "class": "narrative",
      "layerIndex": 4,
      "path": "media/Scenes/fly",
      "blendMode": "multiply",
      "baseOpacity": 1.0,
      "allowedMovements": ["micro_jitter"],
      "allowedMovements_b1": ["slow_pan_left", "slow_pan_right", "micro_jitter"],
      "allowedMovements_b2": ["rapid_pulse", "subtle_zoom"],
      "defaultAppearance": "hard_cut"
    },
    "logo": {
      "enabled": true,
      "class": "narrative",
      "layerIndex": 5,
      "path": "media/Scenes/logo",
      "blendMode": "normal", 
      "baseOpacity": 1.0,
      "allowedMovements": ["logo_slam_end"],
      "defaultAppearance": "hard_cut"
    },
    "dust_overlay": {
      "enabled": true,
      "class": "atmosphere",
      "layerIndex": 7,
      "path": "media/sfx/dust",
      "blendMode": "multiply",
      "baseOpacity": 0.8,
      "allowedMovements": ["none"],
      "defaultAppearance": "fade_in_base"
    },
    "vert_lines": {
      "enabled": true,
      "class": "atmosphere",
      "layerIndex": 7,
      "path": "media/sfx/vert-lines",
      "blendMode": "multiply",
      "baseOpacity": 0.2,
      "allowedMovements": ["none"],
      "defaultAppearance": "fade_in_base"
    },    
    "storm_transitions": {
      "enabled": true,
      "class": "transition",
      "layerIndex": 7,
      "path": "media/sfx/transition",
      "blendMode": "multiply",
      "baseOpacity": 1.0,
      "allowedMovements": ["none"],
      "defaultAppearance": "soft_fade"
    }
  }
}